#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if ! getent group nimbuscore >/dev/null; then
  addgroup --system nimbuscore
fi

if ! getent passwd nimbuscore >/dev/null; then
  adduser --system --no-create-home --ingroup nimbuscore --shell /usr/sbin/nologin nimbuscore
fi

mkdir -p /var/lib/nimbuscore/apiserver /var/lib/nimbuscore/agent
chown -R nimbuscore:nimbuscore /var/lib/nimbuscore
chmod 0750 /var/lib/nimbuscore/apiserver /var/lib/nimbuscore/agent

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
fi

db_get nimbuscore/role || true
ROLE="$RET"

case "$ROLE" in
  master)
    systemctl enable nimbus-apiserver >/dev/null 2>&1 || true
    cat <<MSG
nimbuscore installed — role: master.

nimbus-apiserver.service enabled (not started yet). nimbus-agent was NOT
enabled on this machine, since it was declared a master.

Edit /etc/nimbuscore/apiserver.env (join token), then:

  systemctl start nimbus-apiserver

The default apiserver.env bootstraps a brand-new single-replica cluster
with image signature verification disabled — fine for local testing,
not for production. See README.md for a hardened configuration.
MSG
    ;;

  worker)
    if ! command -v docker >/dev/null 2>&1; then
      echo "nimbuscore: role is worker, installing Docker (apt-get install -y docker.io)..."
      if command -v apt-get >/dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io || \
          echo "nimbuscore: automatic Docker install failed — install it yourself (apt install docker.io) before starting nimbus-agent"
      else
        echo "nimbuscore: apt-get not found — install Docker yourself before starting nimbus-agent"
      fi
    fi
    if getent group docker >/dev/null; then
      usermod -aG docker nimbuscore || true
    fi

    systemctl enable nimbus-agent >/dev/null 2>&1 || true
    cat <<MSG
nimbuscore installed — role: worker.

nimbus-agent.service enabled (not started yet). nimbus-apiserver was NOT
enabled on this machine, since it was declared a worker.

Edit /etc/nimbuscore/agent.env (node name, control-plane address, join
token), then:

  systemctl start nimbus-agent

If Docker was just installed, the nimbuscore user was added to the
docker group — a fresh service start (not just enable) picks that up.
MSG
    ;;

  *)
    cat <<MSG
nimbuscore installed — no role selected, no service was enabled.

Run 'sudo dpkg-reconfigure nimbuscore' to pick master or worker, or
enable the right service yourself:

  systemctl enable --now nimbus-apiserver   # control plane
  systemctl enable --now nimbus-agent       # node running pods (needs Docker)
MSG
    ;;
esac

exit 0
